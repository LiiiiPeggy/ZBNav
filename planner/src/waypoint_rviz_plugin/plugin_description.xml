<library path="waypoint_rviz_plugin">
  <class name="waypoint_rviz_plugin/WaypointTool"
         type="waypoint_rviz_plugin::WaypointTool"
         base_class_type="rviz_common::Tool">
    <description>
      A tool for sending waypoints
    </description>
  </class>
  <!-- ################################ -->
  <!-- XML: register MULTI waypoint RViz tool -->
  <!-- ################################ -->
  <class name="waypoint_rviz_plugin/MultiWaypointTool"
         type="waypoint_rviz_plugin::MultiWaypointTool"
         base_class_type="rviz_common::Tool">
    <description>
      Add MULTI cruise waypoints on the RViz XY plane without requiring point-cloud hits.
    </description>
  </class>
  <!-- ################################ -->
  <!-- XML: register Start Multi trigger tool -->
  <!-- ################################ -->
  <class name="waypoint_rviz_plugin/MultiStartTool"
         type="waypoint_rviz_plugin::MultiStartTool"
         base_class_type="rviz_common::Tool">
    <description>
      Fire /multi_start to begin the prepared cruise route. Legality checks are done by cruiseController.
    </description>
  </class>
</library>